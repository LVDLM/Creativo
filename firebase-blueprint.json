{
  "entities": {
    "Publication": {
      "title": "Publication",
      "description": "A creative piece of writing published by a user.",
      "type": "object",
      "properties": {
        "challengeId": {
          "type": "string",
          "description": "The ID of the challenge or lab tool used."
        },
        "subTitle": {
          "type": "string",
          "description": "The specific sub-prompt title if applicable (e.g., for 'Ponte...')."
        },
        "authorId": {
          "type": "string",
          "description": "The UID of the author."
        },
        "authorName": {
          "type": "string",
          "description": "The display name of the author."
        },
        "content": {
          "type": "string",
          "description": "The written content."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the publication was created."
        },
        "isModerated": {
          "type": "boolean",
          "description": "Whether the content has passed moderation."
        }
      },
      "required": ["challengeId", "authorId", "authorName", "content", "createdAt", "isModerated"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["displayName", "email", "role"]
    }
  },
  "firestore": {
    "/publications/{publicationId}": {
      "schema": "Publication",
      "description": "Public gallery of creative writings."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    }
  }
}
