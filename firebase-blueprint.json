{
  "entities": {
    "Challenge": {
      "title": "Challenge",
      "description": "A creative writing challenge definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the challenge." },
        "title": { "type": "string", "description": "Title of the challenge." },
        "description": { "type": "string", "description": "Instructions for the challenge." },
        "example": { "type": "string", "description": "An example of a successful text." },
        "category": { "type": "string", "description": "Category (e.g., wordplay, poetry, story)." }
      },
      "required": ["id", "title", "description"]
    },
    "Publication": {
      "title": "Publication",
      "description": "A user-submitted text that has been published.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the publication." },
        "challengeId": { "type": "string", "description": "ID of the challenge it belongs to." },
        "authorId": { "type": "string", "description": "UID of the author." },
        "authorName": { "type": "string", "description": "Display name of the author." },
        "content": { "type": "string", "description": "The written text." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was published." },
        "isModerated": { "type": "boolean", "description": "Whether it passed the AI filter." }
      },
      "required": ["id", "challengeId", "authorId", "content", "createdAt"]
    }
  },
  "firestore": {
    "/challenges": {
      "schema": "Challenge",
      "description": "Static list of challenges."
    },
    "/publications": {
      "schema": "Publication",
      "description": "Publicly shared texts."
    }
  }
}
